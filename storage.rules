rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // ── 보안 최소 조치(안 1) ──
    // 새로 만들기: 세 경로 모두 업로드 메타데이터 ownerUid == 업로더 uid일 때만(앱은 세 업로드
    // 모두 ownerUid를 싣는다 — storage_service.dart). 읽기·덮어쓰기·삭제: 기존 파일의 ownerUid가
    // 호출자일 때만, 읽기에 한해 데모 표시(demo == 'true')도 허용 — 데모 파일은 주인(본 계정)만
    // 고친다. 목록 보기는 아무도 못 한다(앱은 목록을 쓰지 않는다). 앱의 화면 표시는
    // getSignedImageUrls의 서명 주소라 이 읽기 규칙을 거치지 않고, 이 규칙의 읽기는 업로드 직후
    // getDownloadURL 한 번뿐이다. 데모 표시와 기존 파일의 ownerUid는 서버 일괄 작업만 붙인다.
    //
    // 배포는 새 APK(누끼·피팅 결과에도 ownerUid를 싣는다)를 설치한 뒤 — 그 전의 빌드는 누끼·피팅
    // 결과 업로드가 이 규칙에 막힌다.
    //
    // 삭제 요청에는 request.resource가 없다(null) — 업로드 검사 함수는 먼저 null을 본다.

    function isValidImage(maxMb) {
      return request.resource == null
          || (request.resource.size < maxMb * 1024 * 1024
              && request.resource.contentType.matches('image/.*'));
    }

    // 커스텀 메타데이터의 값(없으면 ''). 메타데이터 맵이 없거나 키가 없어도 오류 없이 ''.
    function metaOf(res, key) {
      return res.metadata == null ? '' : res.metadata.get(key, '');
    }

    function isMine(res) {
      return metaOf(res, 'ownerUid') == request.auth.uid;
    }

    function isDemo(res) {
      return metaOf(res, 'demo') == 'true';
    }

    // 올리는 파일: ownerUid가 본인이고 데모 표시를 직접 달지 않는다. 같은 경로에 이미 파일이
    // 있으면(덮어쓰기) 그 파일도 본인 것이어야 한다 — 에뮬레이터 실측(2026-11-15): 내용을
    // 덮어쓰는 업로드는 update가 아니라 create로 평가되어, 이 검사가 없으면 다른 계정이 자기
    // uid로 남의 파일·데모 파일을 덮어써 주인이 된다.
    function uploadOwnerOk() {
      return metaOf(request.resource, 'ownerUid') == request.auth.uid
          && metaOf(request.resource, 'demo') == ''
          && (resource == null || isMine(resource));
    }

    // 상한 — 옷 사진 10MB(앱이 이미 압축), 누끼 5MB(투명 PNG, 실측 최댓값의 약 14배), 피팅 결과 10MB.
    match /wardrobe_images/{fileName} {
      allow get: if request.auth != null && (isMine(resource) || isDemo(resource));
      allow list: if false;
      allow create: if request.auth != null && isValidImage(10) && uploadOwnerOk();
      allow update: if request.auth != null && isValidImage(10) && isMine(resource) && uploadOwnerOk();
      allow delete: if request.auth != null && isMine(resource);
    }

    match /wardrobe_cutouts/{fileName} {
      allow get: if request.auth != null && (isMine(resource) || isDemo(resource));
      allow list: if false;
      allow create: if request.auth != null && isValidImage(5) && uploadOwnerOk();
      allow update: if request.auth != null && isValidImage(5) && isMine(resource) && uploadOwnerOk();
      allow delete: if request.auth != null && isMine(resource);
    }

    // 같은 조합을 다시 만들면 같은 경로(fitting_results/{cacheKey}.jpg)에 덮어쓴다 — 본인 파일일
    // 때만. 주인 표시가 없는 옛 결과는 일괄 작업으로 주인을 붙이기 전에는 덮어쓰지 못한다(앱은 그
    // 캐시 갱신 실패를 이미 무시한다).
    match /fitting_results/{fileName} {
      allow get: if request.auth != null && (isMine(resource) || isDemo(resource));
      allow list: if false;
      allow create: if request.auth != null && isValidImage(10) && uploadOwnerOk();
      allow update: if request.auth != null && isValidImage(10) && isMine(resource) && uploadOwnerOk();
      allow delete: if request.auth != null && isMine(resource);
    }
  }
}
