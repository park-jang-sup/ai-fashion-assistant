rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 삭제 요청에는 request.resource가 없다(null) — null 체크가 없으면
    // deleteWardrobeImage()가 전부 permission-denied로 죽는다. 업로드일
    // 때만 크기·타입을 검사하고, 삭제는 그대로 통과시킨다.
    function isValidImage(maxMb) {
      return request.resource == null
          || (request.resource.size < maxMb * 1024 * 1024
              && request.resource.contentType.matches('image/.*'));
    }

    // functions_bg_removal/main.py의 배경 제거 트리거가 대상 문서의
    // ownerUid와 업로드 커스텀 메타데이터의 ownerUid를 대조해 "다른
    // 사용자의 문서에 컷아웃 주입"을 막으려 하는데, 이 검사가 없으면
    // 그 대조가 자기참조가 된다 — 메타데이터 쪽 ownerUid를 업로더가
    // 임의로 실을 수 있어서 대조 자체가 무효였다(등록:
    // docs/task_background_removal_v1.md §1-3 항목5 [정정 2026-08-08]).
    // isValidImage와 같은 이유로 request.resource == null을 먼저 본다
    // — 삭제 요청에는 request.resource가 없으므로 이 검사를 안 건너뛰면
    // 옷 삭제가 전부 permission-denied로 죽는다.
    function isOwnUpload() {
      return request.resource == null
          || request.resource.metadata.ownerUid == request.auth.uid;
    }

    // storage_service.dart가 wardrobe_images/{fileName}에 업로드/삭제한다.
    // Firestore 규칙과 마찬가지로 인증된 사용자(익명 포함)에게만 허용.
    // wardrobe_screen.dart의 pickImage가 imageQuality 80~85로 이미 압축해
    // JPEG는 대체로 1MB 미만이므로 상한 10MB.
    match /wardrobe_images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isValidImage(10) && isOwnUpload();
    }

    // isOwnUpload()를 여기 걸지 않는다 — storage_service.dart의
    // uploadWardrobeCutout은 customMetadata 자체를 안 싣는다(직접
    // 확인). 같은 조건을 걸면 request.resource.metadata.ownerUid에
    // 접근할 대상이 없어 컷아웃 업로드가 통째로 죽는다.
    // storage_service.dart의 uploadWardrobeCutout이 온디바이스 배경 제거
    // 결과(투명 PNG)를 wardrobe_cutouts/{fileName}에 업로드한다. 이쪽은
    // 알파 채널이 있는 무손실 PNG라 같은 해상도에서도 JPEG보다 훨씬 커질
    // 수 있어 wardrobe_images와 상한을 분리한다(공유하면 컷아웃 업로드만
    // 조용히 실패한다). 실측 후 정정(2026-07-31): 콘솔에서 확인한 컷아웃
    // 15건은 실제로 50KB~368KB였다(알파 PNG는 투명 영역이 잘 압축됨).
    // 상한을 5MB로 둔다 — 관측 최댓값의 약 14배 여유이며, 표본이 전부
    // 제품 사진이라 사용자 직접 촬영본은 더 클 수 있어 넉넉하게 잡았다.
    match /wardrobe_cutouts/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isValidImage(5);
    }

    // isOwnUpload()를 여기도 걸지 않는다 — uploadFittingResult도
    // customMetadata를 안 싣는다(직접 확인). 같은 이유로 걸면 죽는다.
    // storage_service.dart의 uploadFittingResult가 가상 피팅 캐시 이미지를
    // fitting_results/{cacheKey}.jpg에 업로드/덮어쓰기한다.
    match /fitting_results/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isValidImage(10);
    }
  }
}
