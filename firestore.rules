rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 옷장 — 본인 것만. ownerUid가 없는 문서(백필 누락)는 읽히지 않는다.
    match /wardrobe/{itemId} {
      allow read: if request.auth != null
                  && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      // update와 delete를 분리한다 — 삭제 요청에는 request.resource가 없어서(null),
      // 여기 묶은 채로 request.resource.data.ownerUid를 검사하면 옷 삭제가 전부
      // permission-denied로 죽는다(storage.rules의 isValidImage와 같은 함정).
      // update만 "수정 후에도 ownerUid가 그대로인가"를 검사해 본인 문서의
      // ownerUid를 남의 uid로 바꿔 상대 옷장에 아이템을 밀어 넣는 경로를 막는다.
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // fitting_job_controller.dart가 가상 피팅 결과를 캐싱하는 컬렉션.
    // doc id가 "사용자 사진 + 옷 조합"의 SHA-256이라 열거만 막으면 충분하다.
    // list를 막는 이유는 "키를 만들 수 없다"이지만, write는 그것만으론
    // 부족하다 — 키를 우연히 알아낸 제3자가 write는 여전히 시도할 수 있으므로
    // "내가 만든 문서만 내 것"을 ownerUid로 검사한다. delete는 쓸 일이 없으므로
    // 막아 캐시 무효화 공격 표면을 아예 없앤다.
    // 기존 캐시 문서에는 ownerUid가 없다 — 새 update 규칙이 그 문서들의 갱신을
    // 막지만(get은 계속 됨), forceRegenerate로 재생성했을 때 캐시 갱신만 조용히
    // 실패하는 정도라 원래 실패를 무시하는 경로다. 별도 마이그레이션 없이 둔다.
    match /fitting_cache/{cacheKey} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // 체형/취향 프로필(키·몸무게·퍼스널컬러 등)은 개인 민감정보라
    // wardrobe/fitting_cache와 달리 본인 문서만 읽고 쓸 수 있게 한다.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 코디 사용 이력(개인화 추천용 축적 데이터) — users/{uid}와 동일하게
    // 본인 것만 읽고 쓸 수 있다. 상위 match는 서브컬렉션까지 커버하지
    // 않으므로 별도 블록이 필요하다.
    match /users/{uid}/history/{historyId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 능동 추천(새 옷 등록 계기로 백그라운드 생성된 코디 카드) — 동일하게
    // 본인 것만 읽고 쓸 수 있다.
    match /users/{uid}/recommendations/{recId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 가상 피팅 스크랩(사용자가 직접 북마크한 결과) — 동일하게 본인 것만
    // 읽고 쓸 수 있다.
    match /users/{uid}/scraps/{scrapId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 에이전트 활동 로그(백그라운드 행동 서사) — 동일하게 본인 것만 읽고 쓸 수 있다.
    match /users/{uid}/agent_logs/{logId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 착장 캘린더(OOTD 기록) — 개인 취향 데이터라 동일하게 본인 것만 읽고 쓸 수 있다.
    match /users/{uid}/calendar/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 에이전트 재시도 태스크(실패한 백그라운드 작업의 상태 지속성) — 동일하게
    // 본인 것만 읽고 쓸 수 있다.
    match /users/{uid}/agent_tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 백그라운드 실행 메타(마지막 실행 시각·결과) — 본인 것만.
    match /users/{uid}/agent_meta/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // FCM 등록 토큰(B단계) — 동일하게 본인 것만. 문서 id를 토큰 문자열
    // 자체로 써서(클라이언트에서 set(token, ...) 형태로 쓴다) 같은 토큰이
    // 중복 등록되지 않게 한다. 여러 기기를 대비해 단일 필드가 아니라
    // 컬렉션으로 둔다(함정 5).
    match /users/{uid}/fcm_tokens/{token} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 데모 옷장 — 심사·시연용 공개 읽기 전용 세트(F'단계). 앱은 읽기만 하고,
    // 채우는 것은 tools/seed_demo_wardrobe 스크립트로만 한다. write를 막아
    // 사용자 데이터(users/{uid}, ownerUid 격리)와 컬렉션 수준에서 분리한다.
    // imageUrl/cutoutImageUrl은 원본 wardrobe 문서 값을 그대로 재사용한다.
    //
    // 정정(2026-07-31, 실측): 예전엔 이게 storage.rules의
    // wardrobe_images/wardrobe_cutouts read 규칙(request.auth != null)이
    // 인증된 다른 계정에도 열려 있어서 로드되는 것으로 적어뒀는데, 실측으로
    // 반증됐다. 매칭되는 match 블록이 아예 없어 기본 거부인 버킷 루트의
    // 파일을 그 다운로드 URL로 로그아웃 상태 브라우저에서 열었더니 정상
    // 표시됐다. Firebase Storage의 다운로드 토큰(?alt=media&token=)은 보안
    // 규칙을 우회하기 때문이다. 즉 데모 이미지가 로드되는 진짜 이유는
    // storage.rules의 read 규칙이 아니라 Firestore에 저장된 절대 다운로드
    // URL이다 — Storage 경로를 uid별로 조여도 데모는 깨지지 않는다.
    match /demo_wardrobe/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // rate_limits/{uid} — 서버 프록시(callGeminiText) 호출량 상한 카운터
    // (2026-08-06, 논문 5.13.5/7.1). **의도적으로 match 블록이 없다.**
    // users/{uid}처럼 본인 read/write를 열면 사용자가 자기 카운터를 지워
    // 상한을 우회할 수 있으므로, 대응 규칙을 아예 안 둬 기본 거부로
    // 막는다 — 클라이언트는 절대 접근 못 하고 functions/의 Admin SDK만
    // 읽고 쓴다. 다음 사람이 "왜 이 컬렉션만 규칙이 없지"라고 묻지 않게
    // 남긴다.
  }
}
